<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces><NetworkInterface autodetermine="true" /></Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
    </General>
    <Internal>
      <SocketReceiveBufferSize min="16MiB" max="32MiB" />
      <SocketSendBufferSize min="4MiB" max="8MiB" />
      <DefragUnreliableMaxSamples>64</DefragUnreliableMaxSamples>
    </Internal>
  </Domain>
</CycloneDDS>
